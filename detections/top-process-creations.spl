index=windows source="WinEventLog:Microsoft-Windows-Sysmon/Operational"
| rex field=_raw "<EventID>(?<SysmonEventID>\d+)</EventID>"
| search SysmonEventID=1
| rex field=_raw "<Data Name='Image'>(?<Image>[^<]*)</Data>"
| where isnotnull(Image)
| stats count as Executions by Image
| sort - Executions
| head 10
